# Configure these in Vercel Project Settings → Environment Variables.
# Resend is the preferred provider. Verify the sending domain and set the
# sender address to a domain approved in the Resend account.
RESEND_API_KEY=re_replace_with_real_secret
RESEND_FROM=Arveno Growth <info@arvenogrowth.com>
MAIL_TO=info@arvenogrowth.com

# Optional SMTP fallback. Set all SMTP values if you use this transport.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-real-user
SMTP_PASS=replace-with-real-password
MAIL_FROM=info@arvenogrowth.com

ALLOWED_ORIGIN=https://www.arvenogrowth.com

# Client portal / CRM database (Postgres).
# Local: leave DATABASE_URL empty and run `npm run dev:portal` (starts a local Postgres automatically).
# Hosted: any Postgres works (Neon, Railway, Supabase's "Connection string" → Transaction pooler).
DATABASE_URL=
# Set to no-verify only if your host needs SSL without certificate verification.
DATABASE_SSL=
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Comma-separated emails allowed into /admin. Create each login with: npm run db -- admin you@domain.com
CONTRACT_ADMIN_EMAILS=your-authorized-email@yourdomain.com

# Legacy Supabase REST backend (used only when DATABASE_URL is empty).
# Needed once more for `npm run db -- import-supabase` to copy existing data into Postgres.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public Calendly event URL used on the post-submission booking page.
# Example: https://calendly.com/your-name/strategy-call
VITE_CALENDLY_URL=

# Private Calendly read token used only by the authorized CRM appointments API.
# Request only users:read and scheduled_events:read scopes; store as a Vercel Secret.
CALENDLY_ACCESS_TOKEN=
